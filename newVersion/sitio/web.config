<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuración equivalente para servidores Windows / IIS (solo se usa si el sitio está en IIS).
  En Apache se usa .htaccess y este archivo se ignora.
  Requiere el módulo URL Rewrite de IIS para las redirecciones.
-->
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <defaultDocument>
      <files><clear /><add value="index.html" /></files>
    </defaultDocument>
    <staticContent>
      <remove fileExtension=".webp" /><mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff2" /><mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webmanifest" /><mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" /><error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
      <remove statusCode="403" /><error statusCode="403" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>
    <security>
      <requestFiltering removeServerHeader="true" allowDoubleEscaping="false">
        <verbs allowUnlisted="false"><add verb="GET" allowed="true" /><add verb="HEAD" allowed="true" /></verbs>
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".php" allowed="false" /><add fileExtension=".bak" allowed="false" />
          <add fileExtension=".old" allowed="false" /><add fileExtension=".sql" allowed="false" />
          <add fileExtension=".log" allowed="false" /><add fileExtension=".env" allowed="false" />
          <add fileExtension=".md" allowed="false" /><add fileExtension=".py" allowed="false" />
        </fileExtensions>
        <hiddenSegments><add segment=".git" /><add segment=".htaccess" /></hiddenSegments>
        <requestLimits maxAllowedContentLength="102400" />
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()" />
        <add name="Cross-Origin-Opener-Policy" value="same-origin" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'none'; manifest-src 'self'" />
        <!-- Descomenta cuando el sitio tenga HTTPS:
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" /> -->
      </customHeaders>
    </httpProtocol>
    <rewrite>
      <rules>
        <rule name="old-somos" stopProcessing="true"><match url="^somosuadec\.html$" ignoreCase="true" /><action type="Redirect" url="/somos-uadec.html" redirectType="Permanent" /></rule>
        <rule name="old-statics" stopProcessing="true"><match url="^statics\.html$" ignoreCase="true" /><action type="Redirect" url="/sie.html" redirectType="Permanent" /></rule>
        <rule name="old-docs" stopProcessing="true"><match url="^(docs|informe|eje)\.html$" ignoreCase="true" /><action type="Redirect" url="/documentos.html" redirectType="Permanent" /></rule>
        <rule name="old-ind" stopProcessing="true"><match url="^(alumno|docente)\.html$" ignoreCase="true" /><action type="Redirect" url="/indicadores.html" redirectType="Permanent" /></rule>
        <rule name="old-aud" stopProcessing="true"><match url="^auditoria\.html$" ignoreCase="true" /><action type="Redirect" url="/auditorias.html" redirectType="Permanent" /></rule>
        <rule name="old-num" stopProcessing="true"><match url="^(numeralia16|numeraliacp)\.html$" ignoreCase="true" /><action type="Redirect" url="/numeralia.html" redirectType="Permanent" /></rule>
        <rule name="old-contacto" stopProcessing="true"><match url="^(contacto_msj\.html|contacto/.*)$" ignoreCase="true" /><action type="Redirect" url="/contacto.html" redirectType="Permanent" /></rule>
        <rule name="old-pdf" stopProcessing="true"><match url="^pdf/(.+\.pdf)$" ignoreCase="true" /><action type="Redirect" url="/docs/{ToLower:{R:1}}" redirectType="Permanent" /></rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
